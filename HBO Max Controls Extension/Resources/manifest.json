{
  "manifest_version": 3,
  "name": "HBO Max Controls",
  "version": "1.4.0",
  "description": "Lokale Tastatursteuerung, Sleep Timer & Awake Check für HBO Max in Safari.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_title": "HBO Max Controls",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/hbo-controls.svg",
      "32": "icons/hbo-controls.svg",
      "48": "icons/hbo-controls.svg",
      "128": "icons/hbo-controls.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hbomax.com/*",
        "https://*.max.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
